# Образец /etc/ml-server.env на сервере. Настоящие значения — только на сервере, не в git.
# Скопировать: sudo cp ml-server.env.example /etc/ml-server.env, заполнить, sudo chmod 600 /etc/ml-server.env

# ключ, с которым приходит бэк (сгенерировать: 64 случайных символа)
ML_API_KEY=

# mock — заглушка без нейронки, openai — любое OpenAI-совместимое API
ML_PROVIDER=openai

# адрес API нейронки, с /v1 на конце; код сам дописывает /chat/completions
UPSTREAM_URL=
# ключ API нейронки — знает только ML-сервер
UPSTREAM_KEY=
# имя модели у провайдера
UPSTREAM_MODEL=

# необязательные
# PORT=8080
# ML_MAX_CONCURRENT=8
# ML_TIMEOUT_MS=60000
