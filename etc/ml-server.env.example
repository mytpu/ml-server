# Образец /etc/ml-server.env на сервере. Настоящие значения — только на сервере, не в git.
# Скопировать: sudo cp ml-server.env.example /etc/ml-server.env, заполнить, sudo chmod 600 /etc/ml-server.env

# ключ, с которым приходит бэк (сгенерировать: 64 случайных символа)
ML_API_KEY=

# mock — заглушка без нейронки, openai — любое OpenAI-совместимое API
ML_PROVIDER=openai

# адрес API нейронки, с /v1 на конце; код сам дописывает /chat/completions
UPSTREAM_URL=

# имя модели у провайдера
UPSTREAM_MODEL=

# --- Политика провайдера и защита личных данных (152-ФЗ) ---
# Уровень доверия к провайдеру: trusted_tpu | trusted_contract | untrusted (по умолчанию untrusted)
# ML_PROVIDER_TRUST=untrusted
# Можно ли отправлять этому провайдеру личные данные (ПДн): true | false (по умолчанию false; запрещено true при untrusted)
# ML_PD_ALLOWED=false
# Режим маскирования личных данных: mask | off (по умолчанию mask; запрещено off при ML_PD_ALLOWED=false)
# ML_PII=mask

# --- DeepSeek V4.1 Flash ---
# Зарубежный провайдер — личные данные не отправляются, маска обязательна.
# ML_PROVIDER=openai
# UPSTREAM_URL=https://api.deepseek.com/v1
# UPSTREAM_MODEL=<имя модели из кабинета DeepSeek>
# UPSTREAM_KEY=
# ML_PROVIDER_TRUST=untrusted
# ML_PD_ALLOWED=false
# ML_PII=mask

# необязательные
# PORT=8080
# ML_MAX_CONCURRENT=8
# ML_TIMEOUT_MS=60000
# когда перед сервером CADDY
# ML_HOST=127.0.0.1
# ключ API нейронки — знает только ML-сервер
# UPSTREAM_KEY=
# сколько мс запрос ждёт свободного места 0 - сразу 429
# ML_QUEUE_WAIT_MS=5000
