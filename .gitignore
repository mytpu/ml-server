.gradle/
build/
# Kotlin 2.x: данные компилятора и сессий
.kotlin/
# IntelliJ, если собирала сама
out/
# ВАЖНО: gradle/wrapper/gradle-wrapper.jar НЕ игнорируем — без него ./gradlew не запустится

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.fleet/

# ---------- Секреты и локальные настройки ----------
# ключи и переменные окружения — никогда в git
.env
.env.*
*.env
!*.env.example
!.env.example
local.properties
# на всякий случай: сертификаты и ключи
*.pem
# Публичный корневой сертификат НУЦ Минцифры (не секрет): нужен Dockerfile.native для HTTPS к GigaChat
!certs/russian_trusted_root_ca.pem
*.key
*.p12
*.jks
*.keystore

# ---------- Логи и временные файлы ----------
*.log
logs/
*.tmp
*.swp
*~
# тела запросов для ручной проверки через curl
req*.json

# ---------- ОС ----------
.DS_Store
Thumbs.db
desktop.ini
